{
  "name": "book-inventory",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.2.15",
  "scripts": {
    "dev": "concurrently -n \"API,VITE\" -c \"cyan,magenta\" \"bun run dev:server\" \"bun run dev:client\"",
    "dev:client": "vite",
    "dev:server": "bun run --hot src/server/index.ts",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "check:file-size": "bun scripts/check-file-size.ts",
    "check:imports": "bun scripts/check-import-depth.ts",
    "check:api-contract": "bun scripts/check-api-contract.ts",
    "check:dead": "bun scripts/check-dead-exports.ts",
    "check:route-tests": "bun scripts/check-route-tests.ts",
    "check:validators": "bun scripts/check-validators.ts",
    "check:no-any": "bun scripts/check-no-any.ts",
    "check:clean-artifacts": "bun scripts/check-clean-artifacts.ts",
    "check:canonical-helpers": "bun scripts/check-canonical-helpers.ts",
    "check:single-writer": "bun scripts/check-single-writer.ts --all",
    "check:d1-writes": "bun scripts/check-d1-writes.ts",
    "check:d1-error-mapping": "bun scripts/check-d1-error-mapping.ts",
    "check:test-isolation": "bun scripts/check-test-isolation.ts",
    "check:doc-numbers": "bun scripts/check-doc-number-uniqueness.ts",
    "check:lanes": "bun scripts/check-lane-ownership.ts",
    "check:plans": "bun scripts/explain-plan.ts",
    "check:changed": "bun scripts/check-changed.ts",
    "check:staged": "bun scripts/check-changed.ts --staged",
    "check:fast": "bun run check:changed",
    "fix:crlf": "bun scripts/normalize-crlf.ts",
    "check:string-packing": "bun scripts/check-string-packing.ts --all",
    "check:no-silent-catch": "bun scripts/check-no-silent-catch.ts",
    "check:seed-integrity": "bun scripts/check-seed-integrity.ts",
    "check:all": "bun run type-check && bun run lint && bun run check:clean-artifacts && bun run check:file-size && bun run check:imports && bun run check:api-contract && bun run check:route-tests && bun run check:validators && bun run check:dead && bun run check:no-any && bun run check:canonical-helpers && bun run check:single-writer && bun run check:d1-writes && bun run check:d1-error-mapping && bun run check:test-isolation && bun run check:doc-numbers && bun run check:string-packing && bun run check:no-silent-catch && bun run check:seed-integrity && bun run check:lanes && bun run check:plans && bun run build && bun test",
    "check:d1-drift": "bun scripts/check-d1-drift.ts",
    "check:d1-junk": "bun scripts/check-d1-junk.ts",
    "type-check": "tsc --noEmit",
    "test": "bun test",
    "db:push": "bun scripts/db-push-bun.ts",
    "db:push:drizzle": "drizzle-kit push",
    "db:push:bun": "bun scripts/db-push-bun.ts",
    "db:query": "bun scripts/db-query.ts",
    "db:generate": "drizzle-kit generate",
    "db:d1:migrate": "wrangler d1 migrations apply book-inventory-db --remote",
    "db:d1:seed:export": "bun scripts/export-d1-seed.ts",
    "db:d1:seed": "wrangler d1 execute book-inventory-db --remote --file=./drizzle/seed-d1.sql",
    "db:d1:query": "wrangler d1 execute book-inventory-db --remote --command",
    "demo:automate": "bun scripts/run-demo-automation.ts"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.4.3",
    "@types/nodemailer": "^8.0.2",
    "better-auth": "^1.7.5",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.7.4",
    "lucide-react": "^1.16.0",
    "nodemailer": "^10.0.11",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.0.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260920.1",
    "@eslint/js": "^9.21.0",
    "@testing-library/react": "^16.3.3",
    "@types/bun": "^1.4.2",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.21",
    "better-sqlite3": "^11.8.1",
    "concurrently": "^10.0.5",
    "drizzle-kit": "^0.30.5",
    "eslint": "^9.21.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^17.12.0",
    "happy-dom": "^21.0.1",
    "playwright": "^1.64.1",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^6.2.0",
    "wrangler": "^4.135.0"
  }
}
