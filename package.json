{
  "name": "book-inventory",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.2.15",
  "scripts": {
    "dev": "concurrently -n \"API,VITE\" -c \"cyan,magenta\" \"bun run dev:server\" \"bun run dev:client\"",
    "dev:client": "vite",
    "dev:server": "bun run --hot src/server/index.ts",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "check:file-size": "bun scripts/check-file-size.ts",
    "check:route-tests": "bun scripts/check-route-tests.ts",
    "type-check": "tsc --noEmit",
    "test": "bun test",
    "db:push": "drizzle-kit push",
    "db:push:bun": "bun scripts/db-push-bun.ts",
    "db:generate": "drizzle-kit generate",
    "db:d1:migrate": "wrangler d1 migrations apply book-inventory-db --remote",
    "db:d1:seed:export": "bun scripts/export-d1-seed.ts",
    "db:d1:seed": "wrangler d1 execute book-inventory-db --remote --file=./drizzle/seed-d1.sql"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.4.3",
    "@types/nodemailer": "^8.0.2",
    "better-auth": "^1.7.5",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.7.4",
    "lucide-react": "^1.16.0",
    "nodemailer": "^10.0.11",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.0.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260920.1",
    "@eslint/js": "^9.21.0",
    "@types/bun": "^1.4.2",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.21",
    "better-sqlite3": "^11.8.1",
    "concurrently": "^10.0.5",
    "drizzle-kit": "^0.30.5",
    "eslint": "^9.21.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^17.12.0",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^6.2.0",
    "wrangler": "^4.135.0"
  }
}
