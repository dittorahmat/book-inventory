#!/bin/sh
# Pre-commit: gates cepat (type-check + file-size + imports + route-tests + validators + dead-exports + no-any + canonical-helpers + lanes + plans)
# + eslint pada file staged (*.ts/*.tsx) agar pelanggaran lint tertangkap lokal,
# bukan menunggu CI (insiden: toLocaleString("id-ID") lolos ke HEAD).
# Suite berat (build/test penuh) tetap ditanggung CI agar commit ringan.
# Terpasang via `bun scripts/setup-hooks.ts` (tanpa dependensi baru).
set -e
STAGED_TS=$(git diff --cached --name-only --diff-filter=ACM -- '*.ts' '*.tsx')
if [ -n "$STAGED_TS" ]; then
  echo "$STAGED_TS" | xargs npx eslint
fi
bun run type-check
bun run check:file-size
bun run check:imports
bun run check:route-tests
bun run check:validators
bun run check:dead
bun run check:no-any
bun run check:canonical-helpers
bun run check:lanes
bun run check:plans
