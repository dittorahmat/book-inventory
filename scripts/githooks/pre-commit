#!/bin/sh
# Pre-commit: gate cepat yang relevan dengan file yang di-commit.
# Selalu: type-check, eslint staged, import-depth, api-contract, lane-ownership.
# Bersyarat: gate yang hanya bermakna bila area terkait tersentuh (server/db/test).
# Suite penuh (build + test + gate repo-wide) tetap ditanggung CI.
# Terpasang via `bun scripts/setup-hooks.ts` (tanpa dependensi baru).
set -e

# Branch guard (AGENTS.md §4.8): tolak commit langsung ke main/master. Gate lain
# memeriksa ISI commit; tak satu pun memeriksa TUJUANNYA - insiden Okt 2026: dua
# commit nyasar ke main dan baru ketahuan saat akan didorong.
# Rebase/merge/cherry-pick yang sedang berjalan dilewati (git memakai hook ini
# juga untuk commit lanjutan), dan penyelesaian konflik di main tak terhalang.
# Paksa bila memang disengaja: ALLOW_MAIN_COMMIT=1 git commit ...
BRANCH=$(git rev-parse --abbrev-ref HEAD)
HOOK_GITDIR=$(git rev-parse --git-dir)
IN_PROGRESS=""
for op in MERGE_HEAD CHERRY_PICK_HEAD REVERT_HEAD rebase-merge rebase-apply; do
  if [ -e "$HOOK_GITDIR/$op" ]; then IN_PROGRESS="$op"; fi
done
if [ -z "$IN_PROGRESS" ] && [ "${ALLOW_MAIN_COMMIT:-0}" != "1" ]; then
  case "$BRANCH" in
    main|master)
      echo "Pre-commit: commit langsung ke '$BRANCH' ditolak (AGENTS.md §4.8)."
      echo "  Buat branch dulu:      git switch -c feat/<slug>"
      echo "  Paksa bila disengaja:  ALLOW_MAIN_COMMIT=1 git commit ..."
      exit 1
      ;;
  esac
fi

# Empty commit guard: tolak commit tanpa staged changes kecuali ada izin eksplisit ALLOW_EMPTY_COMMIT=1
if [ "${ALLOW_EMPTY_COMMIT:-0}" != "1" ] && [ -z "$IN_PROGRESS" ]; then
  if git diff --cached --quiet; then
    echo "Pre-commit: commit kosong (--allow-empty) ditolak."
    echo "  Pastikan ada perubahan file yang di-stage sebelum commit."
    echo "  Paksa bila memang disengaja: ALLOW_EMPTY_COMMIT=1 git commit ..."
    exit 1
  fi
fi

# Seluruh gate file berubah (eslint staged, type-check, gate kondisional) ada di
# satu skrip yang juga dipakai `check:fast`, supaya loop cepat tidak pernah lebih
# longgar dari pre-commit.
bun scripts/check-changed.ts --staged
